  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.live.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.live.test.ts", "src/vite-env.d.ts"],
  "exclude": []
}
